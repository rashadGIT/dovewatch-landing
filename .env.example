# Origin of the real app that Sign In / Get Started / Pricing / Contact link
# to. Defaults to production (https://app.dovewatch.com) when unset. Point
# this at a locally running frontend to test the full click-through flow:
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Origin the /pricing page fetches live plan data from (GET /signup/plans).
# Defaults to production (https://api.dovewatch.com) when unset. The backend
# must have this origin in its CORS_ALLOWED_ORIGINS for the fetch to succeed
# locally — see backend/.env.example.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
